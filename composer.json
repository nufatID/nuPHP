{
    "name": "nufat/nuphp",
    "description": "nuPHP Framework - Light & Fast PHP MVC Framework",
    "keywords": ["framework", "nuphp", "mvc", "php"],
    "homepage": "https://webded.nufat.id",
    "license": "MIT",
    "type": "project",
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3",
        "steampixel/simple-php-router": "^0.7.1",
        "illuminate/database": "^10.0 || ^11.0",
        "illuminate/view": "^10.0 || ^11.0",
        "illuminate/support": "^10.0 || ^11.0",
        "illuminate/pagination": "^10.0 || ^11.0",
        "catfan/medoo": "^2.1",
        "guzzlehttp/guzzle": "^7.8",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0",
        "phpoffice/phpspreadsheet": "^2.0 || ^1.29",
        "fakerphp/faker": "^1.23",
        "lasserafn/php-initial-avatar-generator": "^4.0",
        "picqer/php-barcode-generator": "^2.4 || ^3.0"
    },
    "autoload": {
        "files": [
            "helper/index.php"
        ],
        "psr-4": {
            "App\\Controllers\\": "app/Controllers/",
            "App\\Models\\": "app/Models/",
            "App\\Model\\": "app/Models/",
            "App\\Helper\\": "helper/class/",
            "App\\Core\\": "core/classes/"
        },
        "classmap": [
            "helper/",
            "core/classes/"
        ]
    },
    "authors": [
        {
            "name": "Nufat.id",
            "email": "admin@nufat.id"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}

